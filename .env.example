# Copy to `.env` and adjust as needed. `.env` is gitignored.
# Compose reads this file automatically.

# --- PostgreSQL ---
POSTGRES_DB=missioncontrol
POSTGRES_USER=missioncontrol
POSTGRES_PASSWORD=missioncontrol
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# Signing key for JWTs. Demo-grade, exactly like POSTGRES_PASSWORD above.
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=local-development-only-jwt-signing-secret-change-me

# --- Frontend ---
FRONTEND_PORT=5173
